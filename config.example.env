# Copy this file to config.env and fill in the values.
# config.env stays local to this folder; it is git-ignored and NEVER
# pushed (the repo is public - the cloud gets these via repo secrets).

# --- Email (required) ---
# For Gmail: keep host/port as-is, use your Gmail address as SMTP_USER,
# and create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-step verification). Regular Gmail passwords will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=app-password-here
EMAIL_TO=you@gmail.com
# Optional: defaults to SMTP_USER
# EMAIL_FROM=you@gmail.com

# --- Locations (required) ---
# Names are optional (default "Home"/"Office") and only appear in
# emails and local --status output, never in cloud logs.
HOME_LAT=13.0000
HOME_LON=80.0000
HOME_NAME=Home
OFFICE_LAT=13.0000
OFFICE_LON=80.0000
OFFICE_NAME=Office

# --- Tunables (all optional; defaults shown) ---
# How far ahead to look for "rain starting soon" (minutes)
# IMMINENT_WINDOW_MIN=120
# Minimum rain in one 15-min slot to count as "starting" (mm)
# IMMINENT_SLOT_MM=0.2
# Minimum hourly precipitation probability to alert (%)
# IMMINENT_PROB_MIN=60
# How many of the 3 independent models must agree (ICON, GFS, ECMWF)
# MODEL_AGREE_MIN=2
# A 15-min slot at/above this counts as "wet" when finding rain's end (mm)
# WET_SLOT_MM=0.1
# Minimum gap between repeat alerts of the same kind (hours)
# SUPPRESS_HOURS=3
# Earliest IST time for the daily outlook email
# DAILY_AFTER=06:30
# Alert emails (not the daily outlook) are muted between these IST times
# QUIET_START=23:00
# QUIET_END=05:30
